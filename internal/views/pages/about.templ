package pages

import (
	"github.com/mrtspeedy/kebabspeedy/internal/views/layouts"
	"github.com/mrtspeedy/kebabspeedy/internal/views/components"
)

templ AboutPage() {
	@layouts.BaseLayout("About — mrtspeedy", "night") {
		<section class="min-h-svh py-24 relative">
			
			<div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:32px_32px]"></div>

			<div class="w-full px-8 md:px-16 lg:px-24 relative z-10">
				
				<h1 class="hero-heading text-primary text-center mb-20">
					About Me
				</h1>

				<div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
					
					<div class="lg:col-span-3 flex flex-col items-start text-left w-full">
						
						<div class="w-32 h-32 md:w-48 md:h-48 rounded-full overflow-hidden bg-base-300 mb-6 border border-base-content/10 relative grayscale hover:grayscale-0 transition-all duration-500">
							<img src="https://github.com/mrtspeedy.png?size=400" 
							     alt="mrtspeedy" 
							     class="w-full h-full object-cover opacity-0 transition-opacity duration-500"
							     onload="this.classList.remove('opacity-0')"
							     onerror="this.style.display='none'" />
						</div>
						
						<h2 class="text-4xl font-bold text-base-content tracking-tight font-outfit">mrtspeedy</h2>

                        <p class="text-sm text-base-content/70 font-quicksand font-semibold tracking-widest mt-2">he/they</p>
						
						<p class="text-sm text-base-content/70 font-quicksand font-semibold tracking-widest uppercase mt-2 mb-8">Developer</p>
						
						<div class="flex gap-5 mb-12">
							<a href="https://github.com/mrtspeedy" target="_blank" title="GitHub" class="text-base-content/50 hover:text-base-content transition-colors">
								@components.IconGitHub()
							</a>
							<a href="https://discord.com/users/1095502790534627348" target="_blank" title="Discord" class="text-base-content/50 hover:text-base-content transition-colors">
								@components.IconDiscord()
							</a>
							<a href="https://steamcommunity.com/id/mrtspeedy/" target="_blank" title="Steam" class="text-base-content/50 hover:text-base-content transition-colors">
								@components.IconSteam()
							</a>
						</div>

						<div class="w-full">
							<hr class="border-base-content/10 mb-6">
							<h3 class="text-base-content font-outfit font-bold text-sm tracking-widest uppercase mb-4">Currently</h3>
							<ul class="space-y-4 font-quicksand font-medium text-sm text-base-content/70">
								<li class="flex items-start gap-3">
									<span class="text-base-content/50 mt-0.5">></span> Painstakingly making this website
								</li>
								<li class="flex items-start gap-3">
									<span class="text-base-content/50 mt-0.5">></span> Probably procrastinating on other projects
								</li>
								<li class="flex items-start gap-3">
									<span class="text-base-content/50 mt-0.5">></span> Playing games
								</li>
							</ul>
						</div>

						<div class="w-full mt-10">
							<hr class="border-base-content/10 mb-6">
							<h3 class="text-base-content font-outfit font-bold text-sm tracking-widest uppercase mb-4">Tech Stack</h3>
							<div class="flex flex-wrap justify-start gap-2">
								<span class="px-3 py-1.5 bg-base-content/5 text-base-content text-xs font-quicksand font-semibold rounded border border-base-content/10">Go</span>
								<span class="px-3 py-1.5 bg-base-content/5 text-base-content text-xs font-quicksand font-semibold rounded border border-base-content/10">C++</span>
								<span class="px-3 py-1.5 bg-base-content/5 text-base-content text-xs font-quicksand font-semibold rounded border border-base-content/10">PostgreSQL</span>
                                <span class="px-3 py-1.5 bg-base-content/5 text-base-content text-xs font-quicksand font-semibold rounded border border-base-content/10">Linux</span>
                                <span class="px-3 py-1.5 bg-base-content/5 text-base-content text-xs font-quicksand font-semibold rounded border border-base-content/10">Arch, btw</span>
							</div>
						</div>

					</div>

					<div class="lg:col-span-6 flex flex-col items-center w-full">
						<div class="max-w-3xl w-full text-center flex flex-col items-center">
							
							<div class="w-full">
								<h2 class="text-5xl font-bold font-outfit mb-8 text-base-content tracking-tight">Welcome!</h2>
								<div class="space-y-6 font-quicksand font-medium text-base leading-relaxed text-base-content/80 text-left">
									<p>
										Hey there! Welcome to my website (that I painstakingly have worked on...)!
									</p>
                                    <p>
                                        For now the website is honestly fairly basic, but I like it that way. I think I might add more stuff later, we'll see.
                                    </p>
									<p>
										I'm mainly a backend developer. Currently working with Go, C++ and PostgreSQL. When I'm not coding, I'm probably overthinking or playing games.
									</p>
                                    <p>
                                        I love Linux. Have I told you how much I love Linux? Let me tell you how much I absolutely love Linux. I use Arch, btw.
                                    </p>
                                    <p>
                                        Aside from Linux, I just love computers and even electronics in general. I tend to tinker around with many electronics and I also love trying software too.
                                    </p>
                                    <p>
                                        Games are my passion. I love playing games. I've played a lot of games, some with amazing stories, some with horrible ones. Some with great gameplay and some with horrible gameplay.
                                        Each game has something unique to it and that's what makes it so fun to play them. You get to try a new experience each time. It's a good way to pass time too, and hang out with your friends!
                                    </p>
                                    <p>
                                        Picking a favourite game is a difficult topic, each has its own qualities. I've spent some of the most time in War Thunder and Minecraft, two very different games. So I'll go with them.
                                    </p>
								</div>
							</div>

						</div>
					</div>

					<div class="lg:col-span-3 flex flex-col items-end text-right w-full">
						
						<div class="w-full mb-12">
							<h3 class="text-base-content font-outfit font-bold text-sm tracking-widest uppercase mb-6 border-b border-base-content/10 pb-4">Things I Like</h3>
							
							<div class="flex flex-col gap-4 font-quicksand font-medium text-sm text-base-content/70 w-full items-end">
								<div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">#</span> Gaming</div>
								<div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">#</span> Programming</div>
								<div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">#</span> Linux</div>
								<div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">#</span> I use Arch, btw</div>
								<div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">#</span> Computers</div>
								<div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">#</span> Politics</div>
								<div class="flex items-center justify-end gap-3"><span class="text-base-content/50 font-bold">#</span> Coffee</div>
                                <div class="flex items-center justify-end gap-3"><span class="text-base-content/50 font-bold">#</span> Blahaj</div>
							</div>
						</div>

						<div class="w-full">
							<h3 class="text-base-content font-outfit font-bold text-sm tracking-widest uppercase mb-6 border-b border-base-content/10 pb-4">Games I Like</h3>
							
							<div class="flex flex-col gap-4 font-quicksand font-medium text-sm text-base-content/70 w-full items-end">
								<div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">></span> War Thunder</div>
								<div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">></span> Call of Duty</div>
                                <div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">></span> SCP</div>
                                <div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">></span> Doom</div>
								<div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">></span> Minecraft</div>
								<div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">></span> Wolfenstein</div>
								<div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">></span> Hollow Knight</div>
                                <div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">></span> Metro</div>
                                <div class="flex items-center gap-3 justify-end"><span class="text-base-content/50 font-bold">></span> Resident Evil</div>
							</div>
						</div>

					</div>

				</div>
			</div>
		</section>
	}
}